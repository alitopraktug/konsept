# Sitenin yayınlandığı adres (sitemap, canonical, Open Graph için). Örn: https://konsept.example
NEXT_PUBLIC_SITE_URL=

# WhatsApp numarası: ülke kodlu, artı ve boşluk olmadan
NEXT_PUBLIC_WHATSAPP_NUMBER=905069055651

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SADECE sunucu tarafı. Asla NEXT_PUBLIC_ önekiyle kullanmayın, tarayıcıya gönderilmez.
# Yalnızca admin giriş denemesi sınırlaması (rate limit) için kullanılır.
SUPABASE_SERVICE_ROLE_KEY=

# --- Opsiyonel: bilinmeyen bilgiler boş bırakılırsa sitede gösterilmez ---
# Boşsa varsayılan: https://www.instagram.com/konseptegzotik/
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Opsiyonel: ID girilmezse hiçbir takip scripti yüklenmez ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
